{
  "name": "super-visual",
  "version": "0.1.0-rc.5",
  "private": true,
  "description": "Compile governed React dashboards into semantically bound Power BI applications.",
  "type": "module",
  "bin": {
    "supervisual": "packages/cli/bin/supervisual.mjs"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "stage:1": "node scripts/verify-docs.mjs",
    "stage:2": "npm run stage:1 && node scripts/verify-reference.mjs --source-root ../llm-power-bi",
    "stage:3": "npm run stage:1 && npm run contracts:test && npm run compliance:test && npm run runtime:test && npm run compiler:test",
    "stage:4": "npm run stage:3 && npm run semantic:test && npm run typecheck",
    "stage:5": "npm run stage:4 && npm run solution:test",
    "stage:6": "npm run stage:5 && npm run fabric:test",
    "stage:7": "npm run stage:6 && npm run example:test",
    "stage:8": "npm run stage:7 && npm run cli:test",
    "stage:9": "npm run stage:8 && npm run release:check",
    "reference:verify": "node scripts/verify-reference.mjs",
    "contracts:test": "vitest run packages/contracts/tests",
    "compliance:test": "vitest run packages/compliance/tests",
    "runtime:test": "vitest run packages/runtime-powerbi/tests",
    "compiler:test": "vitest run packages/compiler/tests",
    "semantic:test": "vitest run packages/semantic/tests",
    "solution:test": "vitest run packages/compiler/tests/solution.test.mjs",
    "fabric:test": "vitest run packages/fabric/tests",
    "example:test": "node scripts/verify-adventureworks.mjs && node scripts/verify-adventureworks-deploy.mjs",
    "example:package": "node scripts/verify-adventureworks.mjs --package",
    "adventureworks:deploy": "node examples/adventureworks/deployment/deploy.mjs",
    "hello:test": "node scripts/verify-hello-world.mjs",
    "hello:package": "node scripts/verify-hello-world.mjs --package",
    "claude:test": "vitest run packages/adapter-claude-dashboard/tests && node scripts/verify-claude-import.mjs",
    "claude:package": "node scripts/verify-claude-import.mjs --package",
    "skills:sync": "node scripts/sync-agent-skill.mjs",
    "skills:check": "node scripts/sync-agent-skill.mjs --check",
    "agents:eval": "node scripts/run-agent-evals.mjs",
    "agents:eval:test": "vitest run evals/agent-skills/tests",
    "security:audit": "npm audit --audit-level=moderate",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "security:fuzz": "node scripts/run-security-fuzz.mjs",
    "security:fuzz:ci": "node scripts/run-security-fuzz.mjs --runs 10000",
    "onboarding:test": "npm run cli:test && npm run hello:test",
    "cli:test": "vitest run packages/cli/tests",
    "test": "npm run stage:8 && npm run claude:test && npm run skills:check && npm run agents:eval:test",
    "release:check": "node scripts/release-check.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fflate": "0.8.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@jazzer.js/core": "4.0.0",
    "@types/d3": "7.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "powerbi-visuals-api": "5.11.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Datashow-Pty-Ltd/super-visual.git"
  }
}
