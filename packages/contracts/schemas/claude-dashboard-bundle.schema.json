{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supervisual.dev/contracts/claude-dashboard-bundle.v1.schema.json",
  "title": "Super Visual Claude Dashboard intake bundle",
  "description": "A documented Super Visual interchange format for Claude-style dashboard source. It is not an Anthropic export standard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "format", "name", "entry", "datasets", "routes"],
  "properties": {
    "contractVersion": { "type": "integer", "const": 1 },
    "format": { "type": "string", "const": "claude-dashboard-bundle" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["html", "css", "script"],
      "properties": {
        "html": { "$ref": "#/$defs/safePath" },
        "css": { "$ref": "#/$defs/safePath" },
        "script": { "$ref": "#/$defs/safePath" }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimensions", "measures"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "dimensions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["column", "dimensionIndex"],
              "properties": {
                "column": { "type": "string", "minLength": 1 },
                "dimensionIndex": { "type": "integer", "minimum": 0, "maximum": 5 },
                "use": { "enum": ["key", "label"] },
                "valueType": { "enum": ["string", "number"] }
              }
            }
          },
          "measures": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["column", "seriesKey"],
              "properties": {
                "column": { "type": "string", "minLength": 1 },
                "seriesKey": { "type": "string", "minLength": 1 }
              }
            }
          },
          "includeAxisKeyAs": { "type": "string", "minLength": 1 },
          "includeLabelAs": { "type": "string", "minLength": 1 }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "datasets"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "datasets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "defaultParams": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "type": ["string", "number", "boolean", "null"] },
          { "type": "array", "items": { "type": ["string", "number", "boolean", "null"] } }
        ]
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "target"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "target": { "type": "string", "pattern": "^.+\\[[^\\]]+\\]$" },
          "values": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "boolean"] }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safePath" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))" }
    }
  }
}
