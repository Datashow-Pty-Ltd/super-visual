{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-power-bi.local/contracts/report-app.schema.json",
  "title": "Datashow report application",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "application", "routes", "interactions", "implementation"],
  "properties": {
    "contractVersion": { "type": "integer", "const": 1 },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "defaultRoute", "designSystem", "governanceLabel", "locale", "currencyCode", "filterContext", "navigation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "defaultRoute": { "type": "string", "minLength": 1 },
        "designSystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "governanceLabel": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 2 },
        "currencyCode": { "type": "string", "pattern": "^$|^[A-Z]{3}$" },
        "filterContext": {
          "type": "array",
          "items": { "$ref": "#/$defs/filterContext" }
        },
        "navigation": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "label"],
            "properties": { "id": { "type": "string" }, "label": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "routes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "eyebrow", "summary", "search", "kpis", "sections"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "eyebrow": { "type": "string", "minLength": 1 },
          "summary": {
            "type": "object", "additionalProperties": false, "required": ["headline", "body", "emphasisBinding"],
            "properties": {
              "headline": { "type": "string", "minLength": 1 },
              "body": { "type": "string", "minLength": 1 },
              "emphasisBinding": {
                "anyOf": [
                  { "$ref": "#/$defs/binding" },
                  { "type": "null" }
                ]
              }
            }
          },
          "search": {
            "anyOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["enabled", "placeholder", "dataset", "filterTarget", "placement"],
                "properties": {
                  "enabled": { "type": "boolean" }, "placeholder": { "type": "string", "minLength": 1 },
                  "dataset": { "$ref": "#/$defs/dataset" }, "filterTarget": { "type": "string", "minLength": 1 },
                  "placement": { "type": "string", "const": "top-right" }
                }
              },
              { "type": "null" }
            ]
          },
          "kpis": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "label", "binding", "format", "comparison"],
              "properties": {
                "id": { "type": "string" }, "label": { "type": "string" }, "binding": { "$ref": "#/$defs/binding" },
                "format": { "type": "string", "enum": ["currency-compact", "number", "percent", "text"] },
                "comparison": { "type": ["string", "null"] }
              }
            }
          },
          "sections": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "component", "title", "subtitle", "dataset", "size", "settings"],
              "properties": {
                "id": { "type": "string" },
                "component": { "type": "string", "enum": ["line", "bar", "pie", "treegraph", "ranked-table", "small-multiples", "ticker", "live-search", "sankey", "kpi-ledger"] },
                "title": { "type": "string" }, "subtitle": { "type": ["string", "null"] }, "dataset": { "$ref": "#/$defs/dataset" },
                "size": { "type": "string", "enum": ["compact", "standard", "wide", "full", "continuation"] },
                "settings": {
                  "anyOf": [
                    { "type": "object", "additionalProperties": false, "properties": {}, "required": [] },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["source", "action", "target", "invalidates"],
        "properties": {
          "source": { "type": "string" }, "action": { "type": "string", "const": "filter" }, "target": { "$ref": "#/$defs/dataset" },
          "invalidates": { "type": "array", "items": { "$ref": "#/$defs/dataset" } }
        }
      }
    },
    "implementation": {
      "type": "object", "additionalProperties": false, "required": ["mode", "sourceContract"],
      "properties": {
        "mode": { "type": "string", "const": "generated-react-source" },
        "sourceContract": { "type": "string", "const": "report-source.v1" }
      }
    }
  },
  "$defs": {
    "dataset": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "filterContext": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "label", "mode", "required", "visible", "defaultValue", "reason"],
      "properties": {
        "target": { "type": "string", "pattern": "^.+\\[[^\\]]+\\]$" },
        "label": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "const": "single-select" },
        "required": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "defaultValue": { "type": ["string", "number", "boolean", "null"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["dataset", "field", "aggregation"],
      "properties": {
        "dataset": { "$ref": "#/$defs/dataset" }, "field": { "type": "string", "minLength": 1 },
        "aggregation": {
          "anyOf": [
            { "type": "string", "enum": ["sum", "average", "count", "distinct-count", "derived"] },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
