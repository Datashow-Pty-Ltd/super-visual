{
  "summary": "One governed categorical dataset for the hello-world chart.",
  "adapterMode": "source-direct-import",
  "baseModelMutation": false,
  "dataView": {
    "mapping": "table",
    "discriminator": "WidgetId",
    "fields": ["WidgetId", "AxisKey", "Label", "Sort", "SeriesKey", "SeriesLabel", "WidgetValue", "BrokerContext"]
  },
  "widgets": [
    {
      "id": "sales",
      "title": "Sales by category",
      "reportWidgetIds": ["sales"],
      "businessQuestionIds": ["sales-mix"],
      "shape": "categorical",
      "dimensions": [{ "key": "Sales[Category]", "label": "Sales[Category]" }],
      "axis": "Sales[Category]",
      "measures": ["[Total Sales]"],
      "rowLimit": 10,
      "rowSelection": "top-by-value",
      "selectable": false,
      "invalidates": []
    }
  ],
  "cachePolicy": {
    "retainSourceWidget": true,
    "cancelStaleRequests": true,
    "externalFilterInvalidation": "all-dependent-widgets"
  },
  "risks": []
}
