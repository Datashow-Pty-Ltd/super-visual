      "seriesKey": { "max": 1 }, "seriesLabel": { "max": 1 },
      "value": { "min": 1, "max": 1 }, "context": { "min": 1, "max": 1 }
    }],
    "table": { "rows": { "select": [
      { "for": { "in": "widgetId" } }, { "for": { "in": "axisKey" } },
      { "for": { "in": "label" } }, { "for": { "in": "sort" } },
      { "for": { "in": "seriesKey" } }, { "for": { "in": "seriesLabel" } },
      { "for": { "in": "value" } }, { "for": { "in": "context" } }
    ], "dataReductionAlgorithm": { "top": { "count": 30000 } } } }
  }],
  "supportsHighlight": false,
  "supportsKeyboardFocus": true,
