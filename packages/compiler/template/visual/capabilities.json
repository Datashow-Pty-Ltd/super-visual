    { "name": "axisKey", "displayName": "Broker — axis key", "kind": "Grouping" },
    { "name": "label", "displayName": "Broker — label", "kind": "Grouping" },
    { "name": "sort", "displayName": "Broker — sort", "kind": "Grouping" },
    { "name": "seriesKey", "displayName": "Broker — series key", "kind": "Grouping" },
    { "name": "seriesLabel", "displayName": "Broker — series label", "kind": "Grouping" },
    { "name": "value", "displayName": "Broker — value", "kind": "Measure" },
    { "name": "context", "displayName": "Broker — context", "kind": "Measure" }
