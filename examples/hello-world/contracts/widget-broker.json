{
  "contractVersion": 1,
  "summary": "Generated searchable semantic-model catalog used as an end-to-end connectivity proof.",
  "adapterMode": "source-direct-import",
  "baseModelMutation": false,
  "dataView": {
    "mapping": "table",
    "discriminator": "WidgetId",
    "fields": ["WidgetId", "AxisKey", "Label", "Sort", "SeriesKey", "SeriesLabel", "WidgetValue", "BrokerContext"]
  },
  "widgets": [
    {
      "id": "model-catalog",
      "title": "Semantic model entities",
      "reportWidgetIds": ["model-catalog"],
      "businessQuestionIds": ["semantic-connectivity"],
      "shape": "hierarchy",
      "dimensions": [
        { "key": "Super Visual Model Catalog[Entity Type]", "label": "Super Visual Model Catalog[Entity Type]" },
        { "key": "Super Visual Model Catalog[Parent]", "label": "Super Visual Model Catalog[Parent]" },
        { "key": "Super Visual Model Catalog[Entity]", "label": "Super Visual Model Catalog[Entity]" }
      ],
      "axis": "Super Visual Model Catalog[Entity]",
      "measures": ["[Entity Count]"],
      "rowLimit": 250,
      "rowSelection": "first-by-axis",
      "selectable": false,
      "invalidates": []
    }
  ],
  "cachePolicy": {
    "retainSourceWidget": true,
    "cancelStaleRequests": true,
    "externalFilterInvalidation": "all-dependent-widgets"
  },
  "risks": ["The catalog lists declared model metadata but does not expose expressions, parameter values, or business rows."]
}
